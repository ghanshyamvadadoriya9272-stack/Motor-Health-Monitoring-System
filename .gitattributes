# Auto detect text files and perform LF normalization
* text=auto

# Python, HTML, CSS, JS, JSON, Markdown
*.py text eol=lf
*.ipynb text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf

# Batch scripts on Windows need CRLF
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
